# Ignore all files in the images folder
images/*
# ── Dependencies ──────────────────────────────────────────
node_modules/
package-lock.json

# Ignore all files in the audio folder
# ── Build output ───────────────────────────────────────────
dist/
.vite/

# ── Private media assets ───────────────────────────────────
# Exclude raw personal photos and audio from version control
assets/images/*
!assets/images/third/
assets/audio/*

# Ignore all files in the js folder
js/data/*
# ── Generated / exported files ─────────────────────────────
assets/exports/
assets/gallery/
gallery/

# ── Tooling / internal ─────────────────────────────────────
.tools/
artifacts/

# ── OS & editor noise ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
index.vanilla.html

